@using DfE.Analytics.Core.Consumer.Mvc.Controllers
@model List<SchoolVm>

<h2>Search Results</h2>

@if (!Model.Any())
{
    <p>No schools found.</p>
}
else
{
    <form method="post" asp-action="ApplyFilter">
        <input type="hidden" name="filterName" value="Phase" />
        <select name="selectedValue" class="form-select">
            <option value="Primary">Primary</option>
            <option value="Secondary">Secondary</option>
        </select>
        <button type="submit" class="btn btn-secondary mt-2">Apply Filter</button>
    </form>

    <ul class="mt-3">
        @foreach (var s in Model)
        {
            <li>
                <a asp-action="Details" asp-route-urn="@s.Urn">@s.Name</a>
                (@s.Phase)
            </li>
        }
    </ul>
}
